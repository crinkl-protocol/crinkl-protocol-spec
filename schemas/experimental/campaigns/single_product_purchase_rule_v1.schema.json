{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://protocol/schemas/single_product_purchase_rule_v1",
  "title": "SingleProductPurchaseRuleV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ruleType", "schemaVersion", "protocol", "purpose", "dependencySetRef",
    "productRef", "brandRef", "categoryRef", "purchaseTimeInclusive",
    "minimumQuantity", "minimumNetProductAmount"
  ],
  "properties": {
    "ruleType": { "const": "SINGLE_PRODUCT_PURCHASE_MATCH" },
    "schemaVersion": { "const": 1 },
    "protocol": { "$ref": "#/$defs/protocol" },
    "purpose": { "const": "CONVERSION" },
    "dependencySetRef": { "$ref": "#/$defs/hashRef" },
    "productRef": { "$ref": "#/$defs/nullableHashRef" },
    "brandRef": { "$ref": "#/$defs/nullableHashRef" },
    "categoryRef": { "$ref": "#/$defs/nullableHashRef" },
    "purchaseTimeInclusive": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["minimumUnixMs", "maximumUnixMs"],
          "properties": {
            "minimumUnixMs": { "$ref": "#/$defs/unixMs" },
            "maximumUnixMs": { "$ref": "#/$defs/unixMs" }
          }
        }
      ]
    },
    "minimumQuantity": { "$ref": "#/$defs/nullableU32Positive" },
    "minimumNetProductAmount": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["minorUnits", "currency"],
          "properties": {
            "minorUnits": { "$ref": "#/$defs/u64" },
            "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
          }
        }
      ]
    }
  },
  "anyOf": [
    { "properties": { "productRef": { "$ref": "#/$defs/hashRef" } } },
    { "properties": { "brandRef": { "$ref": "#/$defs/hashRef" } } },
    { "properties": { "categoryRef": { "$ref": "#/$defs/hashRef" } } }
  ],
  "$defs": {
    "protocol": { "type": "object", "additionalProperties": false, "required": ["protocolVersion"], "properties": { "protocolVersion": { "const": "1.0.0-rc.1" } } },
    "hashRef": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "nullableHashRef": { "oneOf": [{ "$ref": "#/$defs/hashRef" }, { "type": "null" }] },
    "unixMs": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,12})$" },
    "nullableU32Positive": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$" }
      ]
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$"
    }
  }
}
