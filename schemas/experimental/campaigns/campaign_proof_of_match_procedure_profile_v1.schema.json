{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://protocol/schemas/campaign_proof_of_match_procedure_profile_v1",
  "title": "CampaignProofOfMatchProcedureProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tokenType",
    "schemaVersion",
    "profileId",
    "profileVersion",
    "procedureId",
    "procedureVersion",
    "subjectType",
    "supportedSubjectSchemaIds",
    "supportedCampaignEpochSchemaIds",
    "certificateSchemaId",
    "subjectHashRule",
    "proofProfileBindingRule",
    "decisionHashDomain",
    "decisionHashRule",
    "validatorSignatureRule",
    "unknownProfileHandling",
    "stateTransition",
    "authorityBoundary"
  ],
  "properties": {
    "tokenType": { "const": "CAMPAIGN_PROOF_OF_MATCH_PROCEDURE_PROFILE" },
    "schemaVersion": { "const": 1 },
    "profileId": { "const": "campaign.proofOfMatch.procedureProfile" },
    "profileVersion": { "const": 1 },
    "procedureId": { "const": "PROOF_OF_MATCH_VERIFICATION" },
    "procedureVersion": { "const": "1" },
    "subjectType": { "const": "PROOF_OF_MATCH" },
    "supportedSubjectSchemaIds": {
      "const": ["crinkl://protocol/schemas/proof_of_match_v1"]
    },
    "supportedCampaignEpochSchemaIds": {
      "const": ["crinkl://protocol/schemas/campaigns/campaign_epoch_v2"]
    },
    "certificateSchemaId": {
      "const": "crinkl://protocol/schemas/validator_certificate_v1"
    },
    "subjectHashRule": { "const": "SHA256_RFC8785_COMPLETE_OBJECT" },
    "proofProfileBindingRule": {
      "const": "SUBJECT_PROFILE_REF_MUST_EQUAL_EPOCH_PURPOSE_PROFILE_REF"
    },
    "decisionHashDomain": {
      "const": "crinkl.validator-certificate.decision.v1"
    },
    "decisionHashRule": { "const": "SHA256_RFC8785_DECISION_PREIMAGE" },
    "validatorSignatureRule": { "const": "ED25519_RAW_DECISION_HASH" },
    "unknownProfileHandling": { "const": "REJECT" },
    "stateTransition": { "const": "NONE" },
    "authorityBoundary": {
      "const": "QUORUM_ACCEPTS_EXACT_PROOF_WITHOUT_ECONOMIC_AUTHORITY"
    }
  }
}
