{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://protocol/schemas/spend_acceptance_entry_v1",
  "title": "SpendAcceptanceEntryV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entryType", "schemaVersion", "spendId", "spendTokenHash",
    "canonicalHeadEventHash", "spendIssuerId", "issuerKeyRef",
    "spendVerificationPolicyRef", "holderBindingCommitment", "acceptedAtUnixMs"
  ],
  "properties": {
    "entryType": { "const": "SPEND_ACCEPTANCE_ENTRY" },
    "schemaVersion": { "const": 1 },
    "spendId": { "$ref": "#/$defs/identifier" },
    "spendTokenHash": { "$ref": "#/$defs/hashRef" },
    "canonicalHeadEventHash": { "$ref": "#/$defs/hashRef" },
    "spendIssuerId": { "$ref": "#/$defs/identifier" },
    "issuerKeyRef": { "$ref": "#/$defs/hashRef" },
    "spendVerificationPolicyRef": { "$ref": "#/$defs/hashRef" },
    "holderBindingCommitment": { "$ref": "#/$defs/hashRef" },
    "acceptedAtUnixMs": { "$ref": "#/$defs/unixMs" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "hashRef": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "unixMs": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,12})$" }
  }
}
