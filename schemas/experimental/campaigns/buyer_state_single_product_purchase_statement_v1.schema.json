{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://protocol/schemas/buyer_state_single_product_purchase_statement_v1",
  "title": "BuyerStateSingleProductPurchaseStatementV1",
  "description": "One-purchase product, brand, category, quantity, and net-product-amount relation for ConditionV1. The Condition requirement supplies the relative window.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "schemaVersion",
    "protocolVersion",
    "type",
    "productRef",
    "brandRef",
    "categoryRef",
    "minimumQuantity",
    "minimumNetProductAmount",
    "identityResolutionRule"
  ],
  "properties": {
    "domain": { "const": "crinkl:statement:v1" },
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": "1.0.0-rc.1" },
    "type": { "const": "BUYER_STATE_SINGLE_PRODUCT_PURCHASE_V1" },
    "productRef": { "$ref": "#/$defs/hashRef" },
    "brandRef": { "$ref": "#/$defs/hashRef" },
    "categoryRef": { "$ref": "#/$defs/hashRef" },
    "minimumQuantity": { "$ref": "#/$defs/u32Positive" },
    "minimumNetProductAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minorUnits", "currency"],
      "properties": {
        "minorUnits": { "$ref": "#/$defs/u64" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "identityResolutionRule": {
      "const": "EXACT_PURCHASE_LEVEL_PRODUCT_BRAND_AND_CATEGORY_REFS_IN_BOUND_SNAPSHOTS"
    }
  },
  "$defs": {
    "hashRef": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "u32Positive": {
      "type": "string",
      "pattern": "^([1-9][0-9]{0,8}|[1-3][0-9]{9}|4[01][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[01][0-9]{2}|42949672[0-8][0-9]|429496729[0-5])$",
      "maxLength": 10
    },
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "maxLength": 20
    }
  }
}
