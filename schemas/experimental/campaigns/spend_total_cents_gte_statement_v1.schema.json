{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://protocol/schemas/spend_total_cents_gte_statement_v1",
  "title": "BuyerStateSpendTotalCentsGteStatementV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "schemaVersion",
    "protocolVersion",
    "type",
    "field",
    "thresholdCents",
    "currency"
  ],
  "properties": {
    "domain": { "const": "crinkl:statement:v1" },
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": "1.0.0-rc.1" },
    "type": { "const": "BUYER_STATE_SPEND_TOTAL_CENTS_GTE_V1" },
    "field": { "const": "canonical.totalCents" },
    "thresholdCents": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  }
}
