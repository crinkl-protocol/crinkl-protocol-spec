{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://protocol/schemas/proof_profile_v1",
  "title": "ProofProfileV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileType", "schemaVersion", "protocol", "profileId", "profileVersion",
    "status", "purpose", "relationRef", "proofSystem", "curveFamily", "circuitId",
    "verifyingKeyRef", "transcriptBindingRef", "proofEncodingRef",
    "publicInputEncodingRef", "publicInputEncoding", "publicInputOrder",
    "treeProfileRefs", "conformanceSuiteRef"
  ],
  "properties": {
    "profileType": { "const": "PROOF_PROFILE" },
    "schemaVersion": { "const": 1 },
    "protocol": {
      "type": "object", "additionalProperties": false, "required": ["protocolVersion"],
      "properties": { "protocolVersion": { "const": "1.0.0-rc.1" } }
    },
    "profileId": { "const": "SINGLE_PRODUCT_PURCHASE_MATCH_V1" },
    "profileVersion": { "const": "1" },
    "status": { "const": "ADOPTED" },
    "purpose": { "const": "CONVERSION" },
    "relationRef": { "$ref": "#/$defs/hashRef" },
    "proofSystem": { "const": "HALO2_IPA" },
    "curveFamily": { "const": "PASTA" },
    "circuitId": { "const": "H2_SINGLE_PRODUCT_PURCHASE_MATCH_V1" },
    "verifyingKeyRef": { "$ref": "#/$defs/hashRef" },
    "transcriptBindingRef": { "$ref": "#/$defs/hashRef" },
    "proofEncodingRef": { "$ref": "#/$defs/hashRef" },
    "publicInputEncodingRef": { "$ref": "#/$defs/hashRef" },
    "publicInputEncoding": { "const": "RFC8785_NAMED_COMMITMENTS_V1" },
    "publicInputOrder": {
      "type": "array", "minItems": 39, "maxItems": 39, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "valueType"],
        "properties": {
          "name": { "$ref": "#/$defs/identifier" },
          "valueType": { "enum": ["IDENTIFIER", "ENUM", "SHA256_REF", "POSEIDON_FP", "UNIX_MS"] }
        }
      }
    },
    "treeProfileRefs": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": { "$ref": "#/$defs/hashRef" }
    },
    "conformanceSuiteRef": { "$ref": "#/$defs/hashRef" }
  },
  "$defs": {
    "hashRef": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }
  }
}
