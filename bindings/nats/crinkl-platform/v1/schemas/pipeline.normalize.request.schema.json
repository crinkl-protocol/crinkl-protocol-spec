{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://bindings/nats/crinkl-platform/v1/pipeline.normalize.request",
  "title": "pipeline.normalize.request",
  "$ref": "#/$defs/NormalizationRequestCommand",
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "IsoDateTimeLoose": { "type": "string", "format": "iso-date-time-loose" },
    "NormalizationRequestPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["submissionId", "receivedAt", "sessionId"],
      "properties": {
        "submissionId": { "$ref": "#/$defs/NonEmptyString" },
        "receivedAt": { "$ref": "#/$defs/IsoDateTimeLoose" },
        "tenantId": { "$ref": "#/$defs/NonEmptyString" },
        "sessionId": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "CommandContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wallet": { "$ref": "#/$defs/NonEmptyString" },
        "tenantId": { "$ref": "#/$defs/NonEmptyString" },
        "sessionId": { "$ref": "#/$defs/NonEmptyString" },
        "submissionId": { "$ref": "#/$defs/NonEmptyString" },
        "issuedBy": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "NormalizationRequestCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": ["commandId", "commandName", "payload", "timestamp", "protocolVersion"],
      "properties": {
        "commandId": { "$ref": "#/$defs/NonEmptyString" },
        "commandName": { "const": "NORMALIZE_REQUEST" },
        "payload": { "$ref": "#/$defs/NormalizationRequestPayload" },
        "timestamp": { "$ref": "#/$defs/IsoDateTimeLoose" },
        "protocolVersion": { "const": "1.0.0-rc.2" },
        "context": { "$ref": "#/$defs/CommandContext" }
      }
    }
  }
}
