{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://bindings/nats/crinkl-platform/v1/event.deadletter",
  "title": "event.deadletter",
  "type": "object",
  "additionalProperties": true,
  "required": ["receivedAt", "consumer", "originalSubject", "kind"],
  "properties": {
    "receivedAt": { "type": "string", "format": "iso-date-time-loose" },
    "consumer": { "type": "string", "minLength": 1 },
    "originalSubject": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["DECODE_ERROR", "SCHEMA_INVALID", "HANDLER_ERROR"] },
    "error": { "type": "string" },
    "issues": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "payload": {},
    "dataBase64": { "type": "string" }
  }
}

