{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://bindings/nats/crinkl-platform/v1/pipeline.ingest.receipt",
  "title": "pipeline.ingest.receipt",
  "$ref": "#/$defs/IngestReceiptCommand",
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "IsoDateTimeLoose": { "type": "string", "format": "iso-date-time-loose" },
    "IngestReceiptPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["submissionId", "objectKey", "receivedAt", "sessionId"],
      "properties": {
        "submissionId": { "$ref": "#/$defs/NonEmptyString" },
        "objectKey": { "$ref": "#/$defs/NonEmptyString" },
        "objectKeys": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } },
        "receivedAt": { "$ref": "#/$defs/IsoDateTimeLoose" },
        "tenantId": { "$ref": "#/$defs/NonEmptyString" },
        "sessionId": { "$ref": "#/$defs/NonEmptyString" },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "CommandContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "wallet": { "$ref": "#/$defs/NonEmptyString" },
        "tenantId": { "$ref": "#/$defs/NonEmptyString" },
        "sessionId": { "$ref": "#/$defs/NonEmptyString" },
        "submissionId": { "$ref": "#/$defs/NonEmptyString" },
        "issuedBy": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "IngestReceiptCommand": {
      "type": "object",
      "additionalProperties": true,
      "required": ["commandId", "commandName", "payload", "timestamp", "protocolVersion"],
      "properties": {
        "commandId": { "$ref": "#/$defs/NonEmptyString" },
        "commandName": { "const": "INGEST_RECEIPT" },
        "payload": { "$ref": "#/$defs/IngestReceiptPayload" },
        "timestamp": { "$ref": "#/$defs/IsoDateTimeLoose" },
        "protocolVersion": { "const": "1.0.0-rc.1" },
        "context": { "$ref": "#/$defs/CommandContext" }
      }
    }
  }
}
