{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crinkl://bindings/nats/crinkl-platform/v1/pipeline.ocr.final.normalize.done",
  "title": "pipeline.ocr.final.normalize.done",
  "$ref": "#/$defs/OcrFinalNormalizeDonePayload",
  "$defs": {
    "NonEmptyString": { "type": "string", "minLength": 1 },
    "IsoDateTimeLoose": { "type": "string", "format": "iso-date-time-loose" },
    "OcrFinalRequestPayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["submissionId", "objectKey", "requestedAt", "sessionId"],
      "properties": {
        "submissionId": { "$ref": "#/$defs/NonEmptyString" },
        "objectKey": { "$ref": "#/$defs/NonEmptyString" },
        "objectKeys": { "type": "array", "items": { "$ref": "#/$defs/NonEmptyString" } },
        "requestedAt": { "$ref": "#/$defs/IsoDateTimeLoose" },
        "tenantId": { "$ref": "#/$defs/NonEmptyString" },
        "sessionId": { "$ref": "#/$defs/NonEmptyString" }
      }
    },
    "FinalOcrOutput": {
      "type": "object",
      "additionalProperties": true,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "stitchedPath": { "$ref": "#/$defs/NonEmptyString" },
        "imageTexts": { "type": "array", "items": { "type": "string" } },
        "imageOrder": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SdtFallback": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "store": { "type": "string" },
        "storeId": { "type": "string" },
        "storeCanonicalName": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "confidence": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "store": { "type": "number" },
            "date": { "type": "number" },
            "total": { "type": "number" }
          }
        }
      }
    },
    "SoftHints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "store": { "type": "string" },
        "date": { "type": "string" },
        "totalCents": { "type": "number" },
        "currency": { "type": "string" },
        "softExtractedFields": { "type": "object", "additionalProperties": true },
        "injectedFields": { "type": "array", "items": { "type": "string" } },
        "riskFlags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "NormalizedReceipt": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "store": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "currency": { "type": "string" },
        "location": { "type": "string" },
        "lineItems": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "version": { "type": "string" }
      }
    },
    "OcrFinalNormalizeDonePayload": {
      "type": "object",
      "additionalProperties": true,
      "required": ["request", "finalOcr", "receivedAt"],
      "properties": {
        "request": { "$ref": "#/$defs/OcrFinalRequestPayload" },
        "finalOcr": { "$ref": "#/$defs/FinalOcrOutput" },
        "receivedAt": { "$ref": "#/$defs/IsoDateTimeLoose" },
        "sdtFallback": { "$ref": "#/$defs/SdtFallback" },
        "softHints": { "$ref": "#/$defs/SoftHints" },
        "normalizedReceipt": { "$ref": "#/$defs/NormalizedReceipt" },
        "normalizedRaw": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
