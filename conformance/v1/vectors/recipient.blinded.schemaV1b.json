      "expectedLeafCanonical": "{\"batchId\":\"batch-v2b\",\"recipientId\":\"sha256:b81583e01689f6e6eca5598139dc7b8ed0bc8eac4522d46a220b8efefb6ea942\",\"rewardEventsRoot\":\"d4e5f67890a1b2c3d4e5f67890a1b2c3d4e5f67890a1b2c3d4e5f67890a1b2c3\",\"totalPoints\":\"200\"}",
