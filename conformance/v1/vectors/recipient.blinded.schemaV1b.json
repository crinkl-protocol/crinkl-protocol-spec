      "walletAddress": "0x4444444444444444444444444444444444444444",
      "blinder": "jkl012",
      "expectedRecipientId": "sha256:51db6f692865578bd7db6eab770752a0413ecd9647949971bbdc3889f8014fb2",
      "claims": [
        {
          "spendId": "spend-1",
          "points": "100",
          "rewardEventHash": "1111111111111111111111111111111111111111111111111111111111111111"
        },
        {
          "spendId": "spend-2",
          "points": "150",
          "rewardEventHash": "2222222222222222222222222222222222222222222222222222222222222222"
        },
        {
          "spendId": "spend-3",
          "points": "250",
          "rewardEventHash": "3333333333333333333333333333333333333333333333333333333333333333"
        }
      ],
      "expectedAggregatedLeaf": {
        "batchId": "batch-xyz",
        "recipientId": "sha256:51db6f692865578bd7db6eab770752a0413ecd9647949971bbdc3889f8014fb2",
        "totalPoints": "500"
      },
      "expectedLeafCanonical": "{\"batchId\":\"batch-xyz\",\"recipientId\":\"sha256:51db6f692865578bd7db6eab770752a0413ecd9647949971bbdc3889f8014fb2\",\"totalPoints\":\"500\"}",
      "expectedLeafHashHex": "050eba7aded20a640461afb86d208e6373da91b2eae6951b7ab06f79c66c8aca"
    },
    {
