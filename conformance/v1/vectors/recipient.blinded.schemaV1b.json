{
  "kind": "recipient.blinded.schemaV1b",
  "cases": [
    {
      "id": "blinded.basic.singleRecipient",
      "description": "Basic blinded recipient commitment (wallet + blinder)",
      "walletAddress": "0x1111111111111111111111111111111111111111",
      "blinder": "abc123",
      "expectedRecipientId": "sha256:4416c15eba454916cb1ef247528561caa55f7735c88e2aa7ee7f59e50aa8c98d",
      "expectedLeafCanonical": "{\"batchId\":\"batch-1\",\"recipientId\":\"sha256:4416c15eba454916cb1ef247528561caa55f7735c88e2aa7ee7f59e50aa8c98d\",\"totalPoints\":\"100\"}",
      "expectedLeafHashHex": "12f11e2cd094b0ff0937f2e9525c78485e7d49c9445db3cdc977a54a93dcc120",
      "batchId": "batch-1",
      "totalPoints": "100"
    },
    {
      "id": "blinded.crossBatch.unlinkable",
      "description": "Same wallet with different blinders produces unlinkable recipient IDs",
      "walletAddress": "0x2222222222222222222222222222222222222222",
      "blinderBatch1": "def456",
      "blinderBatch2": "ghi789",
      "expectedRecipientIdBatch1": "sha256:8c48fd43a6c391d14c1ff6f7d8fe75fa5e739cf5bba0669860dec187a78b2418",
      "expectedRecipientIdBatch2": "sha256:b9e2a8c6fe7db5c49d8e1f3a2c5b7e9d1f3a5c7e9b1d3f5a7c9e1f3a5c7e9b1d",
      "unlinkabilityNote": "Observer cannot determine these are the same wallet without the blinder openings"
    },
    {
      "id": "blinded.selectiveDisclosure.opening",
      "description": "User can prove ownership by revealing wallet + blinder",
      "walletAddress": "0x3333333333333333333333333333333333333333",
      "blinder": "ghi789",
      "expectedRecipientId": "sha256:76f0d56ad24358e1f55a079896d17a892dc99a1ab80e0ca61916bdf988b0f405",
      "openingProof": {
        "wallet": "0x3333333333333333333333333333333333333333",
        "blinder": "ghi789",
        "recomputedRecipientId": "sha256:76f0d56ad24358e1f55a079896d17a892dc99a1ab80e0ca61916bdf988b0f405"
      },
      "verificationNote": "Verifier recomputes hash(wallet + blinder) and confirms it equals recipientId in leaf"
    },
    {
      "id": "blinded.aggregation.sameBlindedId",
